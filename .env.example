# Taskfella local development configuration.
# Copy this file to .env. These values are local placeholders, not production credentials.

# Required: the PostgreSQL database started by `docker compose up -d --wait db`.
DATABASE_URL=postgresql://taskfella:taskfella@localhost:5433/taskfella

# Required: canonical origin used by the application foundation.
APP_URL=http://localhost:3000

# Optional: structured log verbosity (debug, info, warn, or error).
LOG_LEVEL=info

# Optional: maximum number of PostgreSQL connections for this process.
DB_POOL_MAX=10

# Keep false for direct local development. The repository's Next development
# proxy marks its own forwarding hop; production must set true behind a proxy
# that strips and sets X-Real-IP or the first X-Forwarded-For address.
AUTH_TRUSTED_PROXY=false

# Authentication message delivery. Local mode writes safe test messages to the
# ignored .local/mail directory and needs no external credentials.
EMAIL_DELIVERY_MODE=local
EMAIL_LOCAL_CAPTURE_DIR=.local/mail
EMAIL_FROM=Taskfella <no-reply@localhost>

# Production must set EMAIL_DELIVERY_MODE=smtp and provide an explicit SMTP
# relay configuration. These are placeholders only, never real credentials.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=replace-with-smtp-username
EMAIL_SMTP_PASSWORD=replace-with-smtp-password

# Optional in development. Uncomment both lines after creating a Google OAuth
# Web application. Leaving them commented redirects browser sign-in to a clear
# not-configured state without weakening email/password authentication. In
# production replace both placeholders with runtime-only real credentials.
# GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
