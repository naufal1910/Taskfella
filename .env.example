# Taskfella Phase 0 local development configuration.
# Copy this file to .env. These values are local placeholders, not production credentials.

# Required: the PostgreSQL database started by `docker compose up -d --wait db`.
DATABASE_URL=postgresql://taskfella:taskfella@localhost:5433/taskfella

# Required: canonical origin used by the application foundation.
APP_URL=http://localhost:3000

# Optional: structured log verbosity (debug, info, warn, or error).
LOG_LEVEL=info

# Optional: maximum number of PostgreSQL connections for this process.
DB_POOL_MAX=10

# Future authentication placeholders (not used in Phase 0).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_PROVIDER_URL=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
# SESSION_SECRET=
